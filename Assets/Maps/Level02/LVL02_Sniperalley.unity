  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::NotePickup
  promptText: Read note
  noteContent: "Hey Leon,\n\nThe Security systems acting up again,\nIf the laser
    gates are back up, head into the security office and input this sequence in,
    from left to right, Dont worry about getting it wrong, the security bots should
    activate if they detect it wrong wrong, and will head to the room to help.\n\n    
    5,1,4,  "
  notePanel: {fileID: 669520245}
  noteText: {fileID: 1537127015814050878}
